name: Bug Notification Workflow

on:
  issues:
    types: [opened, reopened, labeled]
  schedule:
    - cron: '0 9 * * *'  # Daily at 9 AM UTC

permissions:
  contents: read
  issues: read

jobs:
  notify-bugs:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Find bug issues
        id: find_bugs
        uses: actions/github-script@v7
        with:
          script: |
            const issues = await github.rest.issues.listForRepo({
              owner: context.repo.owner,
              repo: context.repo.repo,
              labels: 'bug',
              state: 'open',
              sort: 'created',
              direction: 'desc',
              per_page: 10
            });

            const bugIssues = issues.data.filter(issue => !issue.pull_request);
            
            if (bugIssues.length > 0) {
              console.log(`Found ${bugIssues.length} open bug issues`);
              console.log(JSON.stringify(bugIssues, null, 2));
              return bugIssues;
            }
            return [];
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Create issue notification
        if: steps.find_bugs.outputs.result != '[]'
        uses: actions/github-script@v7
        with:
          script: |
            const bugs = ${{ steps.find_bugs.outputs.result }};
            
            if (bugs.length > 0) {
              let bugList = bugs.map(bug => 
                `- [#${bug.number}](${bug.html_url}): ${bug.title}`
              ).join('\n');
              
              const notificationIssue = await github.rest.issues.create({
                owner: context.repo.owner,
                repo: context.repo.repo,
                title: `🐛 Bug Report Summary - ${new Date().toISOString().split('T')[0]}`,
                body: `## Open Bug Issues\n\n${bugList}\n\n*Generated by Bug Notification Workflow*`,
                assignees: ['Lo-rraine'],
                labels: ['bug-notification', 'automated']
              });
              
              console.log(`Created notification issue: ${notificationIssue.data.html_url}`);
            }
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
